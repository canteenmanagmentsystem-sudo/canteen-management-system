generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ======================================================
// ENUMS
// ======================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum PartyType {
  EMPLOYEE
  DEPARTMENT
  CONTRACTOR
  GUEST
  OTHER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum SaleType {
  INDIVIDUAL
  BULK
  DEPARTMENT
  COUNTER
}

enum SaleStatus {
  DRAFT
  POSTED
  CANCELLED
  REFUNDED
}

enum PaymentMode {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  CHEQUE
  ADJUSTMENT
  OTHER
}

enum PaymentStatus {
  POSTED
  CANCELLED
}

enum LedgerEntryType {
  SALE
  PAYMENT
  REFUND
  DISCOUNT
  ADJUSTMENT
  OPENING_BALANCE
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
  PARTIAL
  CANCELLED
}

enum StockTransactionType {
  PURCHASE
  SALE
  WASTAGE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RETURN_TO_SUPPLIER
  OPENING
}

enum WastageReason {
  SPOILED
  DAMAGED
  EXPIRED
  OVERCOOKED
  LEFTOVER
  OTHER
}

enum ExpenseCategory {
  ELECTRICITY
  GAS
  SALARY
  TRANSPORT
  REPAIR
  CLEANING
  PACKAGING
  MAINTENANCE
  OTHER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  CANCEL
  REFUND
  PAYMENT
  APPROVE
  REJECT
}

// ======================================================
// USERS & SECURITY
// ======================================================

model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique @db.VarChar(50)
  description String? @db.VarChar(255)
  isActive    Boolean @default(true)

  users           User[]
  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id          Int     @id @default(autoincrement())
  code        String  @unique @db.VarChar(100)
  name        String  @db.VarChar(150)
  module      String  @db.VarChar(50)
  description String?
  isActive    Boolean @default(true)

  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([module])
  @@index([isActive])
}

model RolePermission {
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model User {
  id           Int        @id @default(autoincrement())
  username     String     @unique @db.VarChar(50)
  passwordHash String
  fullName     String     @db.VarChar(150)
  email        String?    @unique @db.VarChar(150)
  mobile       String?    @db.VarChar(20)
  status       UserStatus @default(ACTIVE)

  roleId Int
  role   Role @relation(fields: [roleId], references: [id])

  sales             Sale[]             @relation("SaleCreatedBy")
  payments          Payment[]          @relation("PaymentCreatedBy")
  purchases         Purchase[]         @relation("PurchaseCreatedBy")
  expenses          Expense[]          @relation("ExpenseCreatedBy")
  wastages          Wastage[]          @relation("WastageCreatedBy")
  auditLogs         AuditLog[]
  stockTransactions StockTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
  @@index([status])
}

// ======================================================
// ORGANIZATION / DEPARTMENT
// ======================================================

model Department {
  id   Int    @id @default(autoincrement())
  code String @unique @db.VarChar(30)

  // OLD FIELD - TEMPORARY
  // Keep during bilingual migration.
  name        String
  description String?

  // NEW BILINGUAL FIELDS
  // Nullable temporarily so existing records can be migrated safely.
  nameEn        String @db.VarChar(150)
  nameHi        String? @db.VarChar(150)
  descriptionEn String?
  descriptionHi String?

  isActive Boolean @default(true)

  parties          Party[]
  persons          Person[]
  bulkConsumptions BulkConsumption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// PARTIES / PERSONS
// ======================================================

model Party {
  id        Int    @id @default(autoincrement())
  partyCode String @unique @db.VarChar(50)

  // OLD FIELD - TEMPORARY
  partyName String

  // NEW BILINGUAL FIELDS
  partyNameEn String @db.VarChar(200)
  partyNameHi String? @db.VarChar(200)

  partyType PartyType

  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id])

  mobile         String? @db.VarChar(20)
  email          String? @db.VarChar(150)
  address        String?
  openingBalance Decimal @default(0) @db.Decimal(14, 2)

  isActive Boolean @default(true)

  persons  Person[]
  sales    Sale[]
  payments Payment[]
  ledger   LedgerEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partyType])
  @@index([departmentId])
  @@index([partyName])
}

model Person {
  id           Int     @id @default(autoincrement())
  employeeCode String? @unique @db.VarChar(50)

  // OLD FIELD - TEMPORARY
  name String

  // NEW BILINGUAL FIELDS
  nameEn String @db.VarChar(200)
  nameHi String? @db.VarChar(200)

  gender Gender?

  mobile String? @db.VarChar(20)
  email  String? @db.VarChar(150)

  partyId Int?
  party   Party? @relation(fields: [partyId], references: [id])

  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id])

  sales Sale[]

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partyId])
  @@index([departmentId])
  @@index([name])
}

// ======================================================
// FOOD MASTER
// ======================================================

model FoodCategory {
  id Int @id @default(autoincrement())

  // OLD FIELDS - TEMPORARY
  name        String
  description String?

  // NEW BILINGUAL FIELDS
  nameEn        String @unique @db.VarChar(150)
  nameHi        String? @db.VarChar(150)
  descriptionEn String?
  descriptionHi String?

  isActive Boolean @default(true)

  foodItems FoodItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Unit {
  id Int @id @default(autoincrement())

  // OLD FIELD - TEMPORARY
  name String

  // NEW BILINGUAL FIELDS
  nameEn String @unique @db.VarChar(100)
  nameHi String? @db.VarChar(100)

  shortName String @unique @db.VarChar(20)

  isActive Boolean @default(true)

  foodItems FoodItem[]
}

model FoodItem {
  id       Int    @id @default(autoincrement())
  itemCode String @unique @db.VarChar(50)

  // OLD FIELD - TEMPORARY
  name String

  // NEW BILINGUAL FIELDS
  nameEn String @db.VarChar(200)
  nameHi String? @db.VarChar(200)

  categoryId Int
  category   FoodCategory @relation(fields: [categoryId], references: [id])

  unitId Int
  unit   Unit @relation(fields: [unitId], references: [id])

  purchaseRate Decimal? @db.Decimal(12, 2)
  saleRate     Decimal  @default(0) @db.Decimal(12, 2)

  minimumStock Decimal  @default(0) @db.Decimal(12, 3)
  maximumStock Decimal? @db.Decimal(12, 3)

  isStockItem Boolean @default(true)
  isActive    Boolean @default(true)

  saleItems            SaleItem[]
  purchaseItems        PurchaseItem[]
  stockTransactions    StockTransaction[]
  bulkConsumptionItems BulkConsumptionItem[]
  rateMasters          RateMaster[]
  wastages             Wastage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([name])
}

// ======================================================
// RATE MASTER
// ======================================================

model RateMaster {
  id Int @id @default(autoincrement())

  foodItemId Int
  foodItem   FoodItem @relation(fields: [foodItemId], references: [id])

  rate          Decimal   @db.Decimal(12, 2)
  effectiveFrom DateTime
  effectiveTo   DateTime?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([foodItemId])
  @@index([effectiveFrom])
}

// ======================================================
// SALES / BILLING
// ======================================================

model Sale {
  id        Int        @id @default(autoincrement())
  invoiceNo String     @unique @db.VarChar(50)
  saleDate  DateTime   @default(now())
  saleType  SaleType
  status    SaleStatus @default(DRAFT)

  partyId Int?
  party   Party? @relation(fields: [partyId], references: [id])

  personId Int?
  person   Person? @relation(fields: [personId], references: [id])

  subtotal    Decimal @default(0) @db.Decimal(14, 2)
  discount    Decimal @default(0) @db.Decimal(14, 2)
  tax         Decimal @default(0) @db.Decimal(14, 2)
  grandTotal  Decimal @default(0) @db.Decimal(14, 2)
  paidAmount  Decimal @default(0) @db.Decimal(14, 2)
  outstanding Decimal @default(0) @db.Decimal(14, 2)

  notes String?

  createdById Int
  createdBy   User @relation("SaleCreatedBy", fields: [createdById], references: [id])

  items         SaleItem[]
  ledgerEntries LedgerEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([saleDate])
  @@index([partyId])
  @@index([personId])
  @@index([status])
}

model SaleItem {
  id Int @id @default(autoincrement())

  saleId Int
  sale   Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  foodItemId Int
  foodItem   FoodItem @relation(fields: [foodItemId], references: [id])

  quantity Decimal @db.Decimal(12, 3)
  rate     Decimal @db.Decimal(12, 2)
  amount   Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  @@index([saleId])
  @@index([foodItemId])
}

// ======================================================
// PAYMENTS
// ======================================================

model Payment {
  id          Int           @id @default(autoincrement())
  receiptNo   String        @unique @db.VarChar(50)
  paymentDate DateTime      @default(now())
  amount      Decimal       @db.Decimal(14, 2)
  paymentMode PaymentMode
  status      PaymentStatus @default(POSTED)

  partyId Int
  party   Party @relation(fields: [partyId], references: [id])

  referenceNo String? @db.VarChar(100)
  remarks     String?

  createdById Int
  createdBy   User @relation("PaymentCreatedBy", fields: [createdById], references: [id])

  ledgerEntries LedgerEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partyId])
  @@index([paymentDate])
}

// ======================================================
// PARTY LEDGER
// ======================================================

model LedgerEntry {
  id Int @id @default(autoincrement())

  entryDate DateTime        @default(now())
  entryType LedgerEntryType

  partyId Int
  party   Party @relation(fields: [partyId], references: [id])

  saleId Int?
  sale   Sale? @relation(fields: [saleId], references: [id])

  paymentId Int?
  payment   Payment? @relation(fields: [paymentId], references: [id])

  debit  Decimal @default(0) @db.Decimal(14, 2)
  credit Decimal @default(0) @db.Decimal(14, 2)

  description String?

  createdAt DateTime @default(now())

  @@index([partyId])
  @@index([entryDate])
  @@index([entryType])
}

// ======================================================
// BULK CONSUMPTION
// ======================================================

model BulkConsumption {
  id              Int      @id @default(autoincrement())
  consumptionNo   String   @unique @db.VarChar(50)
  consumptionDate DateTime @default(now())

  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id])

  totalPersons Int     @default(0)
  totalAmount  Decimal @default(0) @db.Decimal(14, 2)

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items BulkConsumptionItem[]

  @@index([consumptionDate])
  @@index([departmentId])
}

model BulkConsumptionItem {
  id Int @id @default(autoincrement())

  bulkConsumptionId Int
  bulkConsumption   BulkConsumption @relation(fields: [bulkConsumptionId], references: [id], onDelete: Cascade)

  foodItemId Int
  foodItem   FoodItem @relation(fields: [foodItemId], references: [id])

  quantity Decimal @db.Decimal(12, 3)
  rate     Decimal @db.Decimal(12, 2)
  amount   Decimal @db.Decimal(14, 2)
}

// ======================================================
// SUPPLIERS / PURCHASE
// ======================================================

model Supplier {
  id           Int    @id @default(autoincrement())
  supplierCode String @unique @db.VarChar(50)

  // OLD FIELDS - TEMPORARY
  name    String
  address String?

  // NEW BILINGUAL FIELDS
  nameEn    String @db.VarChar(200)
  nameHi    String? @db.VarChar(200)
  addressEn String?
  addressHi String?

  mobile String? @db.VarChar(20)
  email  String? @db.VarChar(150)
  gstNo  String? @db.VarChar(30)

  isActive Boolean @default(true)

  purchases Purchase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Purchase {
  id           Int            @id @default(autoincrement())
  purchaseNo   String         @unique @db.VarChar(50)
  purchaseDate DateTime       @default(now())
  status       PurchaseStatus @default(DRAFT)

  supplierId Int
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  subtotal Decimal @default(0) @db.Decimal(14, 2)
  discount Decimal @default(0) @db.Decimal(14, 2)
  tax      Decimal @default(0) @db.Decimal(14, 2)
  total    Decimal @default(0) @db.Decimal(14, 2)

  invoiceNo String? @db.VarChar(100)
  remarks   String?

  createdById Int
  createdBy   User @relation("PurchaseCreatedBy", fields: [createdById], references: [id])

  items PurchaseItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([purchaseDate])
}

model PurchaseItem {
  id Int @id @default(autoincrement())

  purchaseId Int
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  foodItemId Int
  foodItem   FoodItem @relation(fields: [foodItemId], references: [id])

  quantity Decimal @db.Decimal(12, 3)
  rate     Decimal @db.Decimal(12, 2)
  amount   Decimal @db.Decimal(14, 2)
}

// ======================================================
// INVENTORY
// ======================================================

model StockTransaction {
  id Int @id @default(autoincrement())

  transactionDate DateTime             @default(now())
  transactionType StockTransactionType

  foodItemId Int
  foodItem   FoodItem @relation(fields: [foodItemId], references: [id])

  quantity Decimal  @db.Decimal(12, 3)
  unitRate Decimal? @db.Decimal(12, 2)

  referenceType String? @db.VarChar(50)
  referenceId   Int?

  remarks String?

  createdById Int
  createdBy   User @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([foodItemId])
  @@index([transactionDate])
  @@index([transactionType])
}

// ======================================================
// WASTAGE
// ======================================================

model Wastage {
  id          Int      @id @default(autoincrement())
  wastageDate DateTime @default(now())

  foodItemId Int
  foodItem   FoodItem @relation(fields: [foodItemId], references: [id])

  quantity Decimal       @db.Decimal(12, 3)
  reason   WastageReason
  remarks  String?

  createdById Int
  createdBy   User @relation("WastageCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([foodItemId])
  @@index([wastageDate])
}

// ======================================================
// EXPENSES
// ======================================================

model Expense {
  id          Int             @id @default(autoincrement())
  expenseNo   String          @unique @db.VarChar(50)
  expenseDate DateTime        @default(now())
  category    ExpenseCategory

  amount      Decimal @db.Decimal(14, 2)
  description String?

  paymentMode PaymentMode @default(CASH)
  referenceNo String?     @db.VarChar(100)

  createdById Int
  createdBy   User @relation("ExpenseCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expenseDate])
  @@index([category])
}

// ======================================================
// AUDIT LOG
// ======================================================

model AuditLog {
  id Int @id @default(autoincrement())

  userId Int?
  user   User? @relation(fields: [userId], references: [id])

  action   AuditAction
  module   String      @db.VarChar(100)
  recordId Int?

  oldData Json?
  newData Json?

  ipAddress String? @db.VarChar(50)
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([module])
  @@index([action])
  @@index([createdAt])
}

// ======================================================
// APPLICATION SETTINGS
// ======================================================

model Setting {
  id          Int     @id @default(autoincrement())
  key         String  @unique @db.VarChar(100)
  value       String?
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
