{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": ".",
    "outDir": "dist",

    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "sourceMap": true
  },

  "include": [
    "src/**/*.ts",
    "generated/**/*.ts"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}